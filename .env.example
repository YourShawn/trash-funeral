# Copy to .env (Compose) or export before running the backend.

# --- MySQL (docker compose / production) ---
MYSQL_DATABASE=trash_funeral
MYSQL_USER=trash
MYSQL_PASSWORD=funeral
MYSQL_ROOT_PASSWORD=rootsecret

# --- Backend ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/trash_funeral?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=trash
SPRING_DATASOURCE_PASSWORD=funeral

# JWT HMAC secret — use at least 32 characters in any real deployment
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_EXPIRATION_MS=604800000

# Optional. When unset, object identification uses a deterministic mock.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local file storage for uploaded photos
UPLOAD_DIR=./uploads

# Frontend (Vite)
VITE_API_BASE=
