# Copy to .env and adjust. Used by docker compose and local Spring Boot.
# Never commit .env. Do not put a public IP or public DNS name for MySQL.

# --- MySQL ---
# Local processes (mvn / tests): loopback only.
# Production/server: private hostname or localhost via uncommitted .env.
# Docker Compose talking to MySQL on the same host: host.docker.internal
#   (or the host gateway). Linux Compose maps this via extra_hosts.
# Bundled demo (`docker compose --profile bundled-mysql`): mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=trash_funeral
MYSQL_USER=trash
MYSQL_PASSWORD=funeral
MYSQL_ROOT_PASSWORD=rootsecret

# --- Backend ---
SERVER_PORT=8080

# JWT HMAC secret — use at least 32 characters in any real deployment
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_EXPIRATION_MS=604800000

# Optional. When unset, object identification uses a deterministic mock.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local file storage for uploaded photos
UPLOAD_DIR=./uploads

# CORS allowed Origin patterns (comma-separated). Browsers send Origin even when
# nginx proxies /api on the same host; Spring rejects unmatched Origins with 403.
# Defaults cover local dev only. For a non-localhost deploy, add the SPA origin
# the browser will send (scheme + host, and :* if the port is non-default):
#   CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://YOUR_HOST,http://YOUR_HOST:*
# Use https://YOUR_HOST if TLS is terminated in front of the app.
# Do not commit a public IP or DNS name here — set it in uncommitted .env.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Frontend (Vite)
VITE_API_BASE=
